rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'baijitsk860@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'baijitsk860@gmail.com') ||
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    // Products: Public shoppers can read published storefront products. Customers cannot write products.
    // Creation, updating, and deletion restricted to authorized administrators.
    match /products/{productId} {
      allow read: if resource == null || resource.data.active != false || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Reviews: Publicly readable for approved reviews. Customers can create; admins moderate.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
    }

    // Return Requests: Customers can create; admins and customer can view; admins update/resolve.
    match /returnRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // User Profiles & subcollections
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /cart/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /wishlist/{productId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Offers: Publicly readable for active promotions, product pages, and checkout validation.
    match /offers/{offerId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders: Anyone can create orders upon checkout.
    // Customers can get their individual order for tracking or confirmation.
    // Listing orders is restricted to the order owner or administrators.
    match /orders/{orderId} {
      allow create: if true;
      allow get: if true;
      allow list: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow update, delete: if isAdmin();
    }

    // Leads: Public can subscribe to drop notifications; admins can read and manage.
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Support Tickets: Customers can create tickets; admins manage and resolve.
    match /supportTickets/{ticketId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // FAQs: Publicly readable for customer knowledge base; manageable by store admins.
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }
  }
}
